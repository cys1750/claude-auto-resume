Load a snapshot offered by the page's host when local storage is empty.

Browser storage is per-device and per-origin, so opening the map from another
device — a phone on the same network — starts from nothing even though the
machine serving it has a full map. There is no way to get data across short of
copying a snapshot file onto the phone and importing it by hand.

This checks for constellate-snapshot.json alongside the page when, and only when,
the local cache turned up empty, and imports it instead of showing the welcome
panel. A 404 is the ordinary case — nothing serves that file by default, and the
fetch fails outright on file:// — so the panel still appears as before. The
Windows launcher serves it when started with -snapshot, which is what makes
viewing an existing map from a phone work at all.

Deliberately narrow: it never runs when the cache already has conversations, so
it cannot overwrite or merge into a map built on the device itself.

diff --git a/index.html b/index.html
index 8a86ae8..ba54ffb 100644
--- a/index.html
+++ b/index.html
@@ -2340,6 +2340,27 @@ $("btn-syncfolder").onclick = connectSyncFolder;
 
 /* ---------------- boot ---------------- */
 
+// A snapshot offered by whatever is serving this page. Browser storage is
+// per-device, so a phone or tablet opening the map over the network starts with
+// an empty cache; if the host puts a snapshot alongside the page, use it instead
+// of showing the welcome panel. Nothing is served by default, and a 404 — the
+// normal case, including on file:// — stays silent.
+async function loadServedSnapshot(){
+  try {
+    const res = await fetch("constellate-snapshot.json", { cache: "no-store" });
+    if (!res.ok) return false;
+    const convs = parseUniversal(await res.json());
+    if (!convs.length) return false;
+    S.convs = convs.sort((a,b)=>a.created-b.created);
+    try { await idb.putAll(S.convs); } catch (e) {}
+    toast(`Loaded ${S.convs.length.toLocaleString()} conversations offered by this page's host.`);
+    await rebuildAll(true);
+    return true;
+  } catch (e) {
+    return false;
+  }
+}
+
 (async function boot(){
   resize();
   try {
@@ -2351,7 +2372,7 @@ $("btn-syncfolder").onclick = connectSyncFolder;
   if (S.convs.length){
     toast(`Restored ${S.convs.length.toLocaleString()} conversations from local cache.`);
     await rebuildAll(true);
-  } else {
+  } else if (!(await loadServedSnapshot())){
     $("empty").style.display = "flex";
   }
   syncBoot();
