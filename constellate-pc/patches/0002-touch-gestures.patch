+function panCamera(dx, dy){
+  const c = R.cam;
+  const right = new THREE.Vector3().subVectors(R.camera.position, c.target).cross(R.camera.up).normalize();
+  const up = new THREE.Vector3().copy(R.camera.up);
+  c.target.addScaledVector(right, dx * c.r * 0.0011);
+  c.target.addScaledVector(up,    dy * c.r * 0.0011);
+}
